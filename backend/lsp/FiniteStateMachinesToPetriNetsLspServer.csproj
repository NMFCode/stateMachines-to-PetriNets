<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>../../vscode/srv</OutputPath>
    <RollForward>LatestMajor</RollForward>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>FiniteStateMachinesToPetriNets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="FiniteStateMachines.nmeta" />
    <None Remove="PetriNets\PetriNets.nmeta" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FiniteStateMachines\FiniteStateMachines.nmeta" />
    <EmbeddedResource Include="PetriNets\PetriNets.nmeta" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NMF-AnyText-LSP" Version="3.0.4" />
    <PackageReference Include="NMF-AnyText-Synchronizations" Version="3.0.4" />
  </ItemGroup>

</Project>
