<?xml version="1.0" encoding="utf-8"?>
<nmeta:Namespace xmi:version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Uri="anytext:petri-nets" Prefix="petri-nets" Name="PetriNets" xmlns:xmi="http://www.omg.org/XMI" xmlns:nmeta="http://nmf.codeplex.com/nmeta/">
  <Types xsi:type="nmeta:Class" Identifier="#//PetriNet/id" IdentifierScope="Global" Name="PetriNet">
    <References IsContainment="true" IsOrdered="true" ReferenceType="nmeta:Class #//Place" UpperBound="-1" Name="places" />
    <References IsContainment="true" IsOrdered="true" ReferenceType="nmeta:Class #//Transition" UpperBound="-1" Name="transitions" />
    <Attributes LowerBound="1" Type="nmeta:PrimitiveType http://nmf.codeplex.com/nmeta/#//String" Name="id" />
  </Types>
  <Types xsi:type="nmeta:Class" Identifier="#//Place/name" IdentifierScope="Global" Name="Place">
    <Attributes Type="nmeta:PrimitiveType http://nmf.codeplex.com/nmeta/#//String" Name="tokenCount" />
    <Attributes LowerBound="1" Type="nmeta:PrimitiveType http://nmf.codeplex.com/nmeta/#//String" Name="name" />
	<References IsUnique="true" ReferenceType="nmeta:Class #//Transition" UpperBound="-1" Opposite="nmeta:Reference #//Transition/to" Name="incoming" />
	<References IsUnique="true" ReferenceType="nmeta:Class #//Transition" UpperBound="-1" Opposite="nmeta:Reference #//Transition/from" Name="outgoing" />
  </Types>
  <Types xsi:type="nmeta:Class" Name="Transition">
    <References IsOrdered="true" ReferenceType="nmeta:Class #//Place" UpperBound="-1" Opposite="nmeta:Reference #//Place/incoming" Name="to" />
    <References IsOrdered="true" ReferenceType="nmeta:Class #//Place" UpperBound="-1" Opposite="nmeta:Reference #//Place/outgoing" Name="from" />
    <Attributes Type="nmeta:PrimitiveType http://nmf.codeplex.com/nmeta/#//String" Name="input" />
  </Types>
</nmeta:Namespace>